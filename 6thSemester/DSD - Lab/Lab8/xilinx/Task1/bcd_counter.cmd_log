xst -intstyle ise -ifn "D:/Uni/DSD - Lab/Lab8/xilinx/Task1/bcd_counter.xst" -ofn "D:/Uni/DSD - Lab/Lab8/xilinx/Task1/bcd_counter.syr" 
ngdbuild -intstyle ise -dd _ngo -nt timestamp -i -p xc6slx9-csg324-2 "bcd_counter.ngc" bcd_counter.ngd  
map -intstyle ise -p xc6slx9-csg324-2 -w -logic_opt off -ol high -t 1 -xt 0 -register_duplication off -r 4 -global_opt off -mt off -ir off -pr off -lc off -power off -o bcd_counter_map.ncd bcd_counter.ngd bcd_counter.pcf 
par -w -intstyle ise -ol high -mt off bcd_counter_map.ncd bcd_counter.ncd bcd_counter.pcf 
trce -intstyle ise -v 3 -s 2 -n 3 -fastpaths -xml bcd_counter.twx bcd_counter.ncd -o bcd_counter.twr bcd_counter.pcf 
