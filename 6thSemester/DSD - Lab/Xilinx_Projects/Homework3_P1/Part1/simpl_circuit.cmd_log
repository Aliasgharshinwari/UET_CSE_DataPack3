map -intstyle ise -p xc6slx9-csg324-2 -w -logic_opt off -ol high -t 1 -xt 0 -register_duplication off -r 4 -global_opt off -mt off -ir off -pr off -lc off -power off -o simpl_circuit_map.ncd simpl_circuit.ngd simpl_circuit.pcf 
par -w -intstyle ise -ol high -mt off simpl_circuit_map.ncd simpl_circuit.ncd simpl_circuit.pcf 
